# prompting.schule example .env - not for production

## Prisma Database
DATABASE_URL="postgresql://prompting_schule_main:PASSWORT_NOGIT@localhost:5432/prompting_schule_main"
SHADOW_DATABASE_URL="postgresql://prompting_schule_main:PASSWORT_NOGIT@localhost:5432/prompting_schule_migrations"

## AI Config
OPENAI_BASE_URL="https://flaait.tugraz.at/llmduckt/llmapi/v1/"
OPENAI_BASE_URL="https://api.openai.com/v1/"
OPENAI_API_KEY="sk-proj-..."
OPENAI_MODEL = "gpt-5-mini"

## Password security
SERVER_PW_SALT="PASSWORT_NOGIT"
SERVER_PW_PEPPER="PASSWORT_NOGIT"
JWT_SECRET="PASSWORT_NOGIT"

## Optional development login (never use these values in production)
DEV_USER_EMAIL="EMAIL_NOGIT"
DEV_USER_PASSWORD="PASSWORT_NOGIT"
# Development role: 0 = Student, 5 = Editor, 6 = Manager, 7 = Admin.
DEV_USER_ROLE=0

## Mail Setup
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_USER="server@localhost.local"
MAIL_PW="PASSWORT_NOGIT"
MAIL_FROM='"Localhost Server" <server@localhost.local>'

## App URL for Badges, Email, ...
PUBLIC_APP_URL="http://localhost:5173"  # no tailing /

## Subfolder, wenn die App unter https://host/<subfolder>/ läuft (ohne Slashes).
## Wird zur Build-Zeit (svelte.config.js → paths.base) UND zur Laufzeit (Cookie-Pfade,
## Redirects, OIDC redirect_uri) gelesen – beim Build muss die Variable also gesetzt sein.
## SUBFOLDER="prompting-schule"

## --- Single-Sign-On (Keycloak / OIDC) ---
## Login-SSO ist aktiv, sobald KEYCLOAK_ISSUER gesetzt ist.
## KEYCLOAK_ISSUER=
## KEYCLOAK_CLIENT_ID=
## KEYCLOAK_CLIENT_SECRET=
## Optionaler Override. Ohne Angabe wird automatisch gebaut:
##   redirect_uri            = <Origin von PUBLIC_APP_URL>/<SUBFOLDER>/login-sso/callback
##   post_logout_redirect_uri = <Origin von PUBLIC_APP_URL>/<SUBFOLDER>/
## PUBLIC_REDIRECT_URI=
## PUBLIC_POST_LOGOUT_REDIRECT=
